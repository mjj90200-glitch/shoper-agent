        "sql": "WITH monthly_sales AS (\n    SELECT\n        dr.region_id,\n        dr.region_name,\n        dd.month,\n        SUM(fo.order_amount) AS month_sales\n    FROM fact_order fo\n    JOIN dim_region dr ON fo.region_id = dr.region_id\n    JOIN dim_date dd ON fo.date_id = dd.date_id\n    WHERE dd.year = 2025\n    GROUP BY dr.region_id, dr.region_name, dd.month\n),\nregion_stats AS (\n    SELECT\n        region_id,\n        region_name,\n        month,\n        month_sales,\n        AVG(month_sales) OVER (PARTITION BY region_id) AS avg_month_sales,\n        STDDEV_POP(month_sales) OVER (PARTITION BY region_id) AS stddev_sales\n    FROM monthly_sales\n)\nSELECT\n    region_name AS 地区,\n    month AS 月份,\n    month_sales AS 销售额,\n    avg_month_sales AS 月平均销售额,\n    stddev_sales AS 总体标准差,\n    CASE\n        WHEN stddev_sales = 0 THEN NULL\n        ELSE (month_sales - avg_month_sales) / stddev_sales\n    END AS `Z-score`,\n    CASE\n        WHEN stddev_sales = 0 THEN '正常'\n        WHEN ABS((month_sales - avg_month_sales) / stddev_sales) > 2 THEN '异常'\n        ELSE '正常'\n    END AS 异常标记\nFROM region_stats\nORDER BY region_name, month LIMIT 1000"
      }
