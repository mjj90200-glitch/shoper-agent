        "sql": "SELECT \n    t.`地区`,\n    t.`品类`,\n    t.`销售额`,\n    t.`销量`,\n    t.`订单数`,\n    t.`销售额占比`,\n    t.`销售额排名`\nFROM (\n    SELECT\n        r.region_name AS `地区`,\n        p.category AS `品类`,\n        SUM(f.order_amount) AS `销售额`,\n        SUM(f.order_quantity) AS `销量`,\n        COUNT(DISTINCT f.order_id) AS `订单数`,\n        SUM(f.order_amount) / NULLIF(SUM(SUM(f.order_amount)) OVER (PARTITION BY r.region_name), 0) * 100 AS `销售额占比`,\n        RANK() OVER (PARTITION BY r.region_name ORDER BY SUM(f.order_amount) DESC) AS `销售额排名`,\n        SUM(SUM(f.order_amount)) OVER (PARTITION BY r.region_name) AS `地区销售额`\n    FROM fact_order f\n    INNER JOIN dim_date d ON f.date_id = d.date_id\n    INNER JOIN dim_product p ON f.product_id = p.product_id\n    INNER JOIN dim_region r ON f.region_id = r.region_id\n    WHERE d.year = 2025\n    GROUP BY r.region_name, p.category\n) t\nORDER BY t.`地区销售额` DESC, t.`销售额` DESC LIMIT 1000"
