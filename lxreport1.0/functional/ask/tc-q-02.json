      "sql": "SELECT r.province, SUM(o.order_amount) AS 销售额 FROM fact_order o JOIN dim_date d ON o.date_id = d.date_id JOIN dim_region r ON o.region_id = r.region_id WHERE d.year = 2025 AND d.quarter = 'Q1' GROUP BY r.province LIMIT 1000"
