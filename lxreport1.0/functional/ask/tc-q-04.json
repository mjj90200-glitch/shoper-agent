    {
      "type": "sql",
      "sql": "SELECT p.product_name, SUM(f.order_amount) AS 销售额\nFROM fact_order f\nJOIN dim_product p ON f.product_id = p.product_id\nWHERE f.date_id BETWEEN 20250101 AND 20250331\nGROUP BY p.product_id, p.product_name\nORDER BY 销售额 DESC\nLIMIT 5"
    },
