    {
      "type": "sql",
      "sql": "SELECT r.region_name AS 地区,\n       SUM(o.order_amount) AS 销售额,\n       SUM(o.order_quantity) AS 销量,\n       COUNT(DISTINCT o.order_id) AS 订单数,\n       SUM(o.order_amount) / SUM(SUM(o.order_amount)) OVER () * 100 AS 销售额占比\nFROM fact_order o\nJOIN dim_date d ON o.date_id = d.date_id\nJOIN dim_region r ON o.region_id = r.region_id\nWHERE d.year = 2025\nGROUP BY r.region_id, r.region_name\nORDER BY 销售额 DESC LIMIT 1000"
    },
