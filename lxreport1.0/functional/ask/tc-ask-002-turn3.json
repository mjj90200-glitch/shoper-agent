    {
      "type": "sql",
      "sql": "SELECT dp.brand AS 品牌, SUM(fo.order_amount) AS 销售总额 FROM fact_order fo JOIN dim_product dp ON fo.product_id = dp.product_id JOIN dim_region dr ON fo.region_id = dr.region_id JOIN dim_date dd ON fo.date_id = dd.date_id WHERE dr.region_name = '华北' AND dd.year = 2025 AND dd.quarter = 'Q1' GROUP BY dp.brand LIMIT 1000"
    },
