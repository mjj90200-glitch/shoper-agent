    {
      "type": "sql",
      "sql": "SELECT dim_region.region_name AS 大区, COUNT(fact_order.order_id) AS 订单数 FROM fact_order INNER JOIN dim_region ON fact_order.region_id = dim_region.region_id WHERE fact_order.date_id BETWEEN 20250101 AND 20250331 GROUP BY dim_region.region_name LIMIT 1000"
