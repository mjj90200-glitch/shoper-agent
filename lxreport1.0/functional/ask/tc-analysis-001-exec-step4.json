    {
      "type": "sql",
      "sql": "SELECT r.region_name AS 地区, d.month AS 月份, SUM(f.order_amount) AS 销售额, SUM(f.order_quantity) AS 销量, COUNT(DISTINCT f.order_id) AS 订单数, SUM(f.order_amount) / SUM(SUM(f.order_amount)) OVER (PARTITION BY r.region_id) * 100 AS 当月销售额占比 FROM fact_order f JOIN dim_date d ON f.date_id = d.date_id JOIN dim_region r ON f.region_id = r.region_id WHERE d.year = 2025 GROUP BY r.region_name, r.region_id, d.month ORDER BY r.region_name, d.month LIMIT 1000"
    },
