    {
      "type": "sql",
      "sql": "SELECT dp.category AS 品类, SUM(fo.order_amount) AS 销售额, SUM(fo.order_quantity) AS 销量, COUNT(DISTINCT fo.order_id) AS 订单数, SUM(fo.order_amount) / SUM(SUM(fo.order_amount)) OVER () AS 销售占比 FROM fact_order fo JOIN dim_product dp ON fo.product_id = dp.product_id WHERE fo.date_id BETWEEN 20250101 AND 20251231 GROUP BY dp.category ORDER BY 销售额 DESC LIMIT 1000"
    },
