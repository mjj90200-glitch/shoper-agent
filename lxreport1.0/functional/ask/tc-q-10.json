    {
      "type": "sql",
      "sql": "SELECT dp.product_id, dp.product_name, SUM(fo.order_amount) AS 销售额 FROM fact_order fo JOIN dim_product dp ON fo.product_id = dp.product_id JOIN dim_region dr ON fo.region_id = dr.region_id WHERE dr.region_name = '华北' GROUP BY dp.product_id, dp.product_name ORDER BY 销售额 DESC LIMIT 3"
    },
