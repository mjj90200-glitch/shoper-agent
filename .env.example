LLM_API_KEY=your_api_key_here

# Local MySQL infrastructure. Docker Compose and the backend share these values.
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
MYSQL_USER=shopkeeper
MYSQL_PASSWORD=replace_with_a_local_app_password
MYSQL_HOST=localhost
MYSQL_PORT=3307

# 火山引擎豆包语音 V3。仅后端读取，不要放进 frontend/.env 或 VITE_* 变量。
VOLCENGINE_TTS_API_KEY=your_volcengine_tts_api_key_here
VOLCENGINE_TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts
# 一般无需修改；只有切换资源或代理地址时才覆盖下面两项。
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
