    {
      "type": "sql",
      "sql": "SELECT SUM(fo.order_amount) AS 销售额\nFROM fact_order fo\nJOIN dim_region dr ON fo.region_id = dr.region_id\nJOIN dim_date dd ON fo.date_id = dd.date_id\nWHERE dr.region_name = '华东' AND dd.year = 2025 AND dd.quarter = 'Q1' LIMIT 1000"
    },
